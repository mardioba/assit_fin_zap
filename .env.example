# ============================================================
# Assistente Financeiro via WhatsApp — exemplo de configuração
# Copie para .env e preencha os valores. NUNCA versione o .env.
# ============================================================

# Ambiente: development | test | production
NODE_ENV=development

# API
PORT=4000
# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Banco de dados
# Desenvolvimento local (sem Docker):
DATABASE_URL="file:./dev.db"
# Produção com PostgreSQL (docker-compose):
# DATABASE_URL="postgresql://assist_fin:senha_forte@postgres:5432/assist_fin?schema=public"

# Segredo JWT — gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_ME_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Em produção defina true (cookies só via HTTPS)
COOKIE_SECURE=false

# ---- Fase 3 (WhatsApp + IA) ----
# Provedor de IA: auto (padrão: openai > gemini > mock) | openai | gemini | mock
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# WhatsApp Business Cloud API oficial (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Token usado na verificação GET do webhook (defina um valor secreto)
WHATSAPP_VERIFY_TOKEN=
# App Secret do app Meta — ativa a validação de assinatura HMAC
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
